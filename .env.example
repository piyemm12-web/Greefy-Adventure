# Copy to .env.local. Never commit real keys.
# Leave ANTHROPIC_API_KEY empty to run in clearly labelled mock mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: force mock mode even when a key is set
# CHAT_MODE=mock
# Verification only: make every model call fail to test error handling
# SIMULATE_MODEL_FAILURE=1
